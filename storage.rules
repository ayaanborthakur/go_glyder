rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // School-wide calendars, parsed from the admin's .ics upload into JSON
    // blobs. Readable by any signed-in user (calendar content isn't
    // sensitive) — checking group/school membership here would cost a
    // Firestore read on every download, defeating the point of caching.
    // Writes are restricted to a verified admin of that school.
    match /calendars/{schoolId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/schools/$(schoolId)/admins/$(request.auth.uid));
    }
  }
}
