rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Profiles are readable by any signed-in user (member lists, profile
    // pages). Only the owner edits their own profile — except carbonMiles,
    // which another user may increment when they carpool them.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['carbonMiles'])
      );

      match /contacts/{contactId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;

        match /messages/{messageId} {
          allow read, write: if isSignedIn() && request.auth.uid == userId;
        }
      }

      match /myGroups/{groupId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Schools. The school doc (name) is public to signed-in users, but the
    // school itself and its secret admin code are created only by the
    // GoGlyder operator (console/CLI) — never by app clients.
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow write: if false;

      // Secret config (the admin code). No client can read or write it, but
      // security-rule get() below still reads it server-side to verify.
      match /private/{doc} {
        allow read, write: if false;
      }

      // Verified admin roster. You can only add YOURSELF, and only if the
      // code you submit matches the school's private admin code. This is what
      // makes admin un-fakeable — setting role:"admin" on your own profile
      // does nothing; the app checks membership here.
      match /admins/{adminUid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.auth.uid == adminUid
          && request.resource.data.code ==
             get(/databases/$(database)/documents/schools/$(schoolId)/private/config)
               .data.adminCode;
        allow delete: if isSignedIn() && request.auth.uid == adminUid;
      }
    }

    // Shared community content: any signed-in user can read/post.
    match /communityPosts/{postId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }

    // Carpool / community groups. Anyone signed in can look one up (needed to
    // join by code) and update the member count; only the owner sets createdBy.
    // A user manages only their own membership doc in the roster.
    match /carpoolGroups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn();

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == memberId;
      }

      // Carpool trips. Anyone signed in can view; only the driver posts a
      // trip; updates (seat fills / cancel) are left open for the MVP.
      match /trips/{tripId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.driverId == request.auth.uid;
        allow update, delete: if isSignedIn();

        // Seat requests: a rider manages their own request doc; the driver
        // (any signed-in user, for the MVP) can update its status.
        match /requests/{riderId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.auth.uid == riderId;
          allow update, delete: if isSignedIn();
        }
      }
    }

    // Shared school calendar events.
    match /calendarEvents/{eventId} {
      allow read: if isSignedIn();
      allow create, delete: if isSignedIn();
    }

    // Direct conversations: only the two participants can read/write the
    // thread and its messages.
    match /conversations/{convId} {
      allow read, update: if isSignedIn()
                          && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read, create: if isSignedIn()
          && request.auth.uid in
             get(/databases/$(database)/documents/conversations/$(convId))
               .data.participants;
      }
    }
  }
}